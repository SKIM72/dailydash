# 이 파일을 .env 로 복사한 뒤 값을 채우세요.   cp .env.example .env
# .env 는 비밀번호가 들어가므로 절대 GitHub 에 올리지 마세요. (.gitignore 에 이미 포함)

# 서버 접속 주소. 공인 IP 또는 도메인. 이 주소로 HTTPS 인증서를 자동 발급합니다.
#   공인 IP 예: 175.201.61.141   (확인: curl https://api.ipify.org)
#   도메인 예 : mydash.duckdns.org
DOMAIN=175.201.61.141

# 화면을 GitHub Pages 에서 띄울 때: 그 주소를 허용 목록에 넣습니다. (쉼표로 여러 개 가능, 경로 없이 출처만)
#   예: https://내계정.github.io
ALLOWED_ORIGINS=https://YOUR-GITHUB-ID.github.io

# 화면 주소 (비밀번호 재설정 메일 링크에 사용). GitHub Pages 라면 저장소 경로까지.
#   예: https://내계정.github.io/dailydash
#   비워두면 https://DOMAIN 을 사용합니다.
APP_URL=https://YOUR-GITHUB-ID.github.io/YOUR-REPO

# DB 비밀번호 - 길고 무작위로, 영문·숫자만 (특수문자는 DB 접속 주소를 깨뜨림). 예: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# 이 이메일 계정은 자동으로 관리자 권한을 받습니다 (기존 최고 관리자 계정)
ADMIN_EMAIL=eowert72@gmail.com

# 오래된 백업 삭제 기준 (일)
BACKUP_KEEP_DAYS=30

# --- (선택) DuckDNS 자동 갱신: DOMAIN 을 duckdns 주소로 쓸 때만 ---
# COMPOSE_PROFILES=duckdns   (자체 Caddy 도 쓰면 COMPOSE_PROFILES=caddy,duckdns)
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# --- (선택) 비밀번호 찾기 메일 발송 ---
# 비워두면 '비밀번호 찾기'는 관리자가 마이페이지에서 임시 비밀번호를 발급하는 방식으로 동작합니다.
# Gmail 예시: SMTP_HOST=smtp.gmail.com / SMTP_PORT=465 / SMTP_USER=내지메일 / SMTP_PASS=앱 비밀번호(16자리)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- (선택) AI 월간 리포트 (Google Gemini) ---
# Google AI Studio(https://aistudio.google.com/apikey)에서 만든 API 키. 비워두면 기능이 꺼집니다.
# 결제를 연결하지 않은 프로젝트의 키는 무료 등급이며, 보낸 내용이 Google 서비스 개선에 쓰일 수 있습니다.
# 자세한 내용: docs/AI-REPORT.md
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- 백업 위치 (DB 와 다른 디스크를 권장) ---
# BACKUP_DIR=./backups

# --- HTTPS(리버스 프록시) 방식: 셋 중 하나 ---
# 앱은 서버 내부(127.0.0.1)의 이 포트로도 열립니다. 외부에는 노출되지 않습니다. (점검용)
APP_HOST_PORT=3780
#
# (1) 같은 서버의 다른 프로젝트 Caddy 를 통해 연결 (그 Caddy 의 Docker 네트워크에 앱만 참여)
#     그 Caddy 설정 끝에:  DOMAIN { reverse_proxy dailydash-app:3000 }
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-proxy.yml
# PROXY_NETWORK=neulremote_default
#
# (2) 80/443 을 DailyDash 혼자 쓰는 서버: 포함된 Caddy 를 켭니다. (duckdns 와 함께면 caddy,duckdns)
# COMPOSE_PROFILES=caddy
# HTTP_PORT=80
# HTTPS_PORT=443
